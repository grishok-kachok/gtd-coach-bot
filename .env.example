# Телеграм
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Мозги — по подписке Claude, а не по API-токену
CLAUDE_CODE_OAUTH_TOKEN=

# Голос (Whisper) — основной вход бота. Два сервиса подряд, оба крутят Whisper.
# Основной с 2026-07-27 — Groq: то же самое, но на их железе (LPU), быстрее и в
# пределах щедрого бесплатного тира бесплатно. Ключ с console.groq.com.
# ⚠️ Groq блокирует РФ (403 напрямую) — обязателен HTTPS_PROXY.
STT_API_KEY=
# Необязательные: без них берутся адрес Groq и whisper-large-v3-turbo.
# STT_API_URL=
# STT_MODEL=

# Запасной сервис: на ЛЮБОЙ осечке Groq бот сразу уходит сюда (whisper-1, платный
# ~$0.36 за час аудио). Он же становится основным, если STT_API_KEY пуст.
OPENAI_API_KEY=
# Необязательные: без них берутся адрес OpenAI и whisper-1.
# FALLBACK_STT_API_URL=
# FALLBACK_STT_MODEL=

# Дела
TODOIST_API_TOKEN=

# Google Календарь (события со слотом времени). OAuth Desktop-app, аккаунт
# vas.efimov@gmail.com, проект GCP coach-calendar-503310, scope .../auth/calendar.
# Refresh-token не протухает (приложение в Production). Секреты — только здесь и
# в Keychain, в git не коммитим. Если пусто — календарь просто не подключается.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Выход из РФ: контейнеры ходят наружу через socat-мост Xray.
# Через него же идёт трафик к Google (oauth2/www.googleapis.com блокируются в РФ).
HTTPS_PROXY=http://172.18.0.1:1080

# Часовой пояс коуча (события, расписание пингов). С сентября — Asia/Makassar (Бали).
COACH_TZ=Europe/Moscow

# Расписания здесь больше нет — оно переехало в мозг, в
# память/состояние/ритмы.md (строгий YAML со схемой). Причина: ритм — настройка
# про человека, а не про инфраструктуру. Из .env его мог поменять только тот,
# у кого есть ssh, и только с перезапуском; из мозга — Василий фразой в телеграме.
# Переменные MORNING_TIME / MIDDAY_TIME / EVENING_TIME / DIGEST_TIME /
# FOLLOWUP_MINUTES / QUIET_HOUR больше не читаются.

# Модели
COACH_MODEL=claude-fable-5
COACH_EFFORT=medium
DIGEST_MODEL=claude-fable-5

# Сколько выжимок подгружать в начало нового разговора — НЕ настройка.
# Окно фиксировано в коде (src/archive.py, WINDOW): 7 дней + 5 недель + 3 месяца.
# Прежняя переменная MEMORY_DAYS убрана 31.07.2026: размер блока должен быть
# известен умножением, а не зависеть от строки в .env на сервере.
