<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vefmv.coach-brain-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/vasiliy/.claude/scripts/coach-brain-sync.sh</string>
    </array>

    <!-- Реакция на правку файлов: срабатывает почти сразу после сохранения -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/vasiliy/Yandex.Disk.localized/Claude Code/gtd</string>
        <string>/Users/vasiliy/Yandex.Disk.localized/Claude Code/gtd/память</string>
        <string>/Users/vasiliy/Yandex.Disk.localized/Claude Code/gtd/память/состояние</string>
        <string>/Users/vasiliy/Yandex.Disk.localized/Claude Code/gtd/память/знания</string>
        <string>/Users/vasiliy/Yandex.Disk.localized/Claude Code/gtd/память/журнал</string>
        <string>/Users/vasiliy/Yandex.Disk.localized/Claude Code/gtd/.bpd</string>
    </array>

    <!-- Подстраховка: ловит правки в новых подпапках и забирает то, что записал бот -->
    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/Users/vasiliy/.claude/logs/coach-brain-sync.err</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
